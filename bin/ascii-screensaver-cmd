#!/bin/bash

# ASCII Screensaver — Generic Animation Launcher (Browser Mode)
#
# Environment variables:
#   ANIMATION   — animation name: bonsai | moon | crawl | blackhole |
#                 aurora | mandelbrot | pipes | fluid | thunderstorm | incense |
#                 nixie | planet | gameoflife | sandmandala | campfire | boids |
#                 windchimes | vinyl | waterfall | jellyfish | terrarium |
#                 aquarium | spiderweb | volcano | oscilloscope | pendulum_wave |
#                 glitch_field | cyber_deck | attractor
#   ANIM_PARAMS — extra URL params string (e.g. "speed=1.5&palette=autumn")
#   START_AT    — shared epoch ms for multi-monitor sync (optional)
#
# Chromium is launched with --class=org.omarchy.screensaver so Omarchy's
# idle service (omarchy.idle, cloned by this plugin's Service.qml) can
# track the window via Hyprland's openwindow/closewindow events.
#
# Uses --app=URL (app mode) instead of --kiosk so window.close() works for
# dismiss logic in viewer.html.

PLUGIN_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
ANIMATION="${ANIMATION:-terrarium}"
SCREENSAVER_CLASS="org.omarchy.screensaver"

# Ensure Wayland environment is set — may be absent when launched via hyprctl dispatch exec
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

USER_ANIMATIONS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/ascii-screensaver/animations"

ANIM_DIR="${PLUGIN_ROOT}/animations/${ANIMATION}/index.html"
if [[ ! -f "$ANIM_DIR" ]]; then
  ANIM_DIR="${USER_ANIMATIONS_DIR}/${ANIMATION}/index.html"
fi

if [[ ! -f "$ANIM_DIR" ]]; then
  echo "ascii-screensaver-cmd: unknown animation '${ANIMATION}'" >&2
  exit 1
fi

# Build base URL pointing to viewer wrapper
VIEWER_HTML="${PLUGIN_ROOT}/system/viewer.html"

if [[ -n "${START_AT:-}" ]]; then
  HTML_URL="file://${VIEWER_HTML}?anim=${ANIMATION}&path=file://${ANIM_DIR}&screensaver=1&startAt=${START_AT}"
else
  HTML_URL="file://${VIEWER_HTML}?anim=${ANIMATION}&path=file://${ANIM_DIR}&screensaver=1&delayedStart=1"
fi

# Read per-animation params from screensaver-config.json.
# We do this here (not in the launcher) to avoid passing & characters through
# hyprctl dispatch exec, which runs commands via sh -c and would misinterpret them.
USER_SCREENSAVER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ascii-screensaver/screensaver-config.json"
if [[ -f "$USER_SCREENSAVER_CONFIG" ]]; then
  SCREENSAVER_CONFIG="$USER_SCREENSAVER_CONFIG"
else
  SCREENSAVER_CONFIG="${PLUGIN_ROOT}/screensaver-config.json"
fi
if [[ -z "${ANIM_PARAMS:-}" ]] && [[ -f "$SCREENSAVER_CONFIG" ]] && command -v jq &>/dev/null; then
  # URL-encode param values to handle special chars (&, =, spaces, etc.)
  ANIM_PARAMS=$(jq -r --arg name "$ANIMATION" '
    (.animations[] | select(.name == $name) | .params // {})
    | to_entries
    | map("\(.key)=\(.value | @uri)")
    | join("&")
  ' "$SCREENSAVER_CONFIG" 2>/dev/null)
fi

[[ -n "${ANIM_PARAMS:-}" ]] && HTML_URL="${HTML_URL}&${ANIM_PARAMS}"
[[ -n "${EXTRA_PARAMS:-}" ]] && HTML_URL="${HTML_URL}&${EXTRA_PARAMS}"

if [[ "${PREVIEW:-}" == "1" ]]; then
  HTML_URL="${HTML_URL}&preview_mode=1"
fi

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null \
    || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -f "animations/${ANIMATION}/index.html" 2>/dev/null
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

if [[ "${PREVIEW:-}" != "1" ]]; then
  hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null \
    || hyprctl keyword cursor:invisible true &>/dev/null
fi

RUN_DIR="${XDG_RUNTIME_DIR}/ascii-screensaver"
mkdir -p "$RUN_DIR"
CHROMIUM_USER_DATA_DIR="$(mktemp -d "${RUN_DIR}/${ANIMATION}-XXXXXXXX")"
CHROMIUM_ERROR_LOG="${RUN_DIR}/chromium-errors.log"

# Use --app=URL (app mode) so window.close() works for dismiss logic.
# --start-fullscreen makes the app window open fullscreen (required for screensaver).
if [[ "${PREVIEW:-}" == "1" ]]; then
  SCREENSAVER_CLASS="ascii-screensaver-preview"
  CHROMIUM_FLAGS="--window-size=600,450 --disable-web-security"
  (
    for i in {1..30}; do
      if hyprctl clients -j | grep -q '"title": "Screensaver Preview"'; then
        hyprctl eval 'hl.dispatch(hl.dsp.window.float("title:Screensaver Preview"))' &>/dev/null
        hyprctl eval 'hl.dispatch(hl.dsp.window.pin("title:Screensaver Preview"))' &>/dev/null
        hyprctl eval 'hl.dispatch(hl.dsp.window.resize({ x=600, y=450, window="title:Screensaver Preview" }))' &>/dev/null
        hyprctl eval 'hl.dispatch(hl.dsp.window.center("title:Screensaver Preview"))' &>/dev/null
        break
      fi
      sleep 0.1
    done
  ) &
else
  CHROMIUM_FLAGS="--start-fullscreen"
fi

chromium \
  --class="$SCREENSAVER_CLASS" \
  --user-data-dir="$CHROMIUM_USER_DATA_DIR" \
  --ozone-platform=wayland \
  --app="$HTML_URL" \
  $CHROMIUM_FLAGS \
  --no-first-run \
  --no-default-browser-check \
  --disable-extensions \
  --disable-background-networking \
  --disable-sync \
  --disable-translate \
  --disable-dev-shm-usage \
  --allow-file-access-from-files \
  --background-color=000000 \
  2>>"$CHROMIUM_ERROR_LOG"

rm -rf "$CHROMIUM_USER_DATA_DIR" 2>/dev/null
exit_screensaver